# Copy to .env and fill in at least one provider key.
# Groq and Gemini free tiers are enough for this learning project.

# groq | gemini | openai
LLM_PROVIDER=groq

GROQ_API_KEY=
# Fast/cheap default for learning. Alternative: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.1-8b-instant

GOOGLE_API_KEY=
# Gemini 3.x needs thinking + thought signatures on tool calls (handled in llm.py).
GEMINI_MODEL=gemini-3.6-flash

# Optional backup if you spend a little of the $20 budget
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# huggingface (local sentence-transformers) or hash (no model download)
EMBEDDING_BACKEND=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: override project root for data/ paths
# MECK_HOME=/path/to/this/repo
